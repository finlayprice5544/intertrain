# ───────────────────────────────────────────────────────────────
#  Generated site (Rust / Axum).  Copy to `.env` and fill in.
#  (Per-project subset of the master `.env.example`. On Railway, set
#   these as service Variables instead of shipping a .env.)
#  Boots even empty: RocksDB is embedded (always on), ClickHouse is
#  optional (falls back to RocksDB seed if unreachable), external APIs
#  fall back to seeded data when keys are missing (DATA_MODE=auto).
# ───────────────────────────────────────────────────────────────

PORT=8787
RUST_LOG=info,generated_site=debug

# ── Branding / the knobs you change per project ────────────────
#  (override config/branding.json; also applied to the cloned
#   frontend by `cargo run --bin rebrand`.)
SITE_NAME="My Project"
TOKEN_TICKER="TICKER"
CONTRACT_ADDRESS=""           # CA — your token mint
TWITTER_URL="https://x.com/yourhandle"
GITHUB_URL="https://github.com/youruser/yourrepo"
DISCORD_URL="https://discord.gg/yourinvite"
TELEGRAM_URL="https://t.me/yourchannel"
WEBSITE_URL="https://yoursite.example"

# ── Data layer ─────────────────────────────────────────────────
#  seed = serve from RocksDB seed only (offline, always works)
#  live = call ClickHouse + external services (needs them up)
#  auto = live, fall back to seed on error/missing (default)
DATA_MODE="auto"
ROCKSDB_PATH="./data/rocks"
PUBLIC_DIR="../frontend"       # the cloned frontend folder (sibling of backend/)

# ── ClickHouse (analytics / events / time-series) ──────────────
#  Easiest: `docker compose up -d clickhouse` then use the defaults below.
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_DATABASE="app"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD=""

# ── Solana / RPC (read-only; execution is simulated) ───────────
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
HELIUS_API_KEY=""             # dev.helius.xyz — if set and SOLANA_RPC_URL blank, URL is derived
SOLANA_CLUSTER="mainnet-beta"

# ── Market data ────────────────────────────────────────────────
DEXSCREENER_BASE="https://api.dexscreener.com"   # no key
JUPITER_BASE="https://lite-api.jup.ag"           # no key on lite
BIRDEYE_API_KEY=""            # birdeye.so (optional)

# ── Storage / token metadata ───────────────────────────────────
PINATA_JWT=""                 # pinata.cloud (only if pinning)
IPFS_GATEWAY="https://ipfs.io/ipfs/"
